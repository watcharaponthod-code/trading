FROM node:18-slim

RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm install
RUN npm install -g pm2

COPY scripts/ ./scripts/
COPY lib/ ./lib/
COPY ecosystem.worker.config.js ./

EXPOSE 8080

CMD ["pm2-runtime", "ecosystem.worker.config.js"]
